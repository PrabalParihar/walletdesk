# sepolia (default): the live Unichain Sepolia deployment, built in (src/lib/live.ts). No variables needed.
# fork: ./script/demo.sh sets this and writes public/deployments.json for the local Unichain fork.
# unichain: live Unichain mainnet deploy (contracts/script/DeployUnichainMainnet.s.sol). Fill the addresses it prints.
# Your own Sepolia deploy (contracts/script/DeployUnichainSepolia.s.sol): set the NEXT_PUBLIC_* addresses below. Aqua is not
#          on Sepolia: set NEXT_PUBLIC_AQUA to the registry that script deployed.
# NEXT_PUBLIC_NETWORK=sepolia
# NEXT_PUBLIC_RPC_URL=https://sepolia.unichain.org
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.io

# Used only when NEXT_PUBLIC_NETWORK is unichain or sepolia and public/deployments.json is absent.
# NEXT_PUBLIC_HOOK=
# NEXT_PUBLIC_SWAP_VM=
# NEXT_PUBLIC_OVERFLOW_ROUTER=
# NEXT_PUBLIC_ORDER_BUILDER=
# NEXT_PUBLIC_PRICE_FEED=
# NEXT_PUBLIC_TOKEN0=
# NEXT_PUBLIC_TOKEN1=
# NEXT_PUBLIC_DECIMALS0=18
# NEXT_PUBLIC_DECIMALS1=18
# NEXT_PUBLIC_MAKER=
# NEXT_PUBLIC_POOL_ID=
# NEXT_PUBLIC_MAX_DEVIATION_BPS=100
# NEXT_PUBLIC_TREASURY=
# NEXT_PUBLIC_USDC=
# NEXT_PUBLIC_ARC_TREASURY=
# NEXT_PUBLIC_POOL_MANAGER=
# NEXT_PUBLIC_AQUA=0x1111113CCf1426A8E30e2bfF5E005d929bF6a90a
# NEXT_PUBLIC_KEEPER_URL=http://127.0.0.1:8787
