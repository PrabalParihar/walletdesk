# fork (default): ./script/demo.sh writes public/deployments.json and the UI reads it.
# unichain: live Unichain mainnet deploy (contracts/script/DeployUnichainMainnet.s.sol). Fill the addresses it prints.
# sepolia: Unichain Sepolia deploy (contracts/script/DeployUnichainSepolia.s.sol). Aqua is not on Sepolia: set NEXT_PUBLIC_AQUA
#          to the registry that script deployed.
NEXT_PUBLIC_NETWORK=fork
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.io

# Used only when NEXT_PUBLIC_NETWORK is unichain or sepolia and public/deployments.json is absent.
